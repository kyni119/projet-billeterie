# Copier ce fichier en .env (racine) et renseigner de vraies valeurs.
# Utilisé par docker-compose.
MYSQL_ROOT_PASSWORD=change-me
DB_NAME=billeterie_db
JWT_SECRET=change-me-long-random-string
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000
EMAIL_USER=
EMAIL_PASSWORD=
# Identifiants admin : le mot de passe est stocké haché (bcrypt).
# Générer : node -e "console.log(require('bcryptjs').hashSync('mon-mot-de-passe', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
